@page
@model Web.Pages.LoginModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="d-flex justify-content-center">
    <div class="card bg-dark text-light shadow p-4" style="max-width: 400px;">
        <h2 class="text-center mb-4 text-primary">Iniciar Sesión</h2>
        <form method="post">
            <div class="mb-3">
                <label class="form-label">Correo electrónico</label>
                <input asp-for="Login.Email" class="form-control" placeholder="usuario@email.com" />
            </div>
            <div class="mb-3">
                <label class="form-label">Contraseña</label>
                <input asp-for="Login.Password" type="password" class="form-control" placeholder="••••••••" />
            </div>
            <button type="submit" class="btn btn-primary w-100">Entrar</button>
        </form>
        <p class="text-center mt-3">
            ¿No tienes cuenta? <a asp-page="/Register" class="text-decoration-none text-info">Regístrate aquí</a>
        </p>
    </div>
</div>
