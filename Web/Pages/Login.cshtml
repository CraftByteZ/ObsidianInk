@page
@model Web.Pages.LoginModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<section class="section">
    <div class="container">
        <div class="card" style="max-width: 400px; margin: auto;">
            <h2 class="title is-3 has-text-centered">Iniciar Sesión</h2>
            <form method="post">
                <div class="field">
                    <label class="label">Email</label>
                    <div class="control">
                        <input class="input" asp-for="Input.Email" placeholder="Tu correo electrónico" />
                    </div>
                </div>
                <div class="field">
                    <label class="label">Contraseña</label>
                    <div class="control">
                        <input class="input" asp-for="Input.Password" type="password" placeholder="Tu contraseña" />
                    </div>
                </div>
                <div class="field">
                    <div class="control">
                        <button class="button is-primary is-fullwidth" type="submit">Entrar</button>
                    </div>
                </div>
            </form>
            <p class="has-text-centered mt-4">
                ¿No tienes cuenta? <a asp-page="/Register">Regístrate aquí</a>
            </p>
        </div>
    </div>
</section>
