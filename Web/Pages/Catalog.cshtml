@page
@model Web.Pages.CatalogModel
@{
    ViewData["Title"] = "Catálogo";
}

<section class="section">
    <div class="container">
        <h1 class="title is-2 has-text-centered mb-5">Catálogo de Libros</h1>
        <div class="columns is-multiline">
            @if (Model.Books == null || !Model.Books.Any())
            {
                <p>No hay libros disponibles.</p>
            }
            else
            {
                @foreach (var book in Model.Books)
                {
                    <div class="column is-one-quarter">
                        <div class="card">
                            <div class="card-content">
                                <p class="title is-4">@book.Title</p>
                                <p class="subtitle is-6">@book.AuthorIds</p>
                                <a class="button is-link is-small mt-3" asp-page="/BookDetails" asp-route-id="@book.Id">Ver detalles</a>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>
