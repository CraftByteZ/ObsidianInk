@page
@model Web.Pages.CatalogModel
@{
    ViewData["Title"] = "Catálogo";
}

<h1 class="text-center text-primary mb-5">Catálogo de Libros</h1>

@if (Model.Books.Count == 0)
{
    <p class="text-center text-muted">No hay libros disponibles.</p>
}
else
{
    <div class="row g-4">
        @foreach (var book in Model.Books)
        {
            <div class="col-md-3">
                <div class="card bg-dark text-light border-0 shadow-sm h-100">
                    <img src="@book.Cover" class="card-img-top rounded" alt="@book.Title">
                    <div class="card-body">
                        <h5 class="card-title text-primary">@book.Title</h5>
                        <p class="card-text">@string.Join(", ", book.AuthorNames)</p>
                        <p class="text-muted">@string.Join(", ", book.GenreNames)</p>
                        <p class="fw-bold">$@book.Price</p>

                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            <form method="post" asp-page-handler="Buy">
                                <input type="hidden" name="bookId" value="@book.Id" />
                                <button type="submit" class="btn btn-outline-primary w-100">Comprar</button>
                            </form>
                        }
                        else
                        {
                            <a asp-page="/Login" class="btn btn-outline-light w-100">Inicia sesión para comprar</a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
