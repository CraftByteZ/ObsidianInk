@page
@model Web.Pages.CatalogModel
@{
    ViewData["Title"] = "Catálogo";
}

<h1 class="title has-text-centered has-text-light">Catálogo de Libros</h1>
<div class="columns is-multiline">
    @if (Model.Books.Count == 0)
    {
        <p class="has-text-grey-light">No hay libros disponibles.</p>
    }
    else
    {
        @foreach (var book in Model.Books)
        {
            <div class="column is-one-quarter">
                <div class="card has-background-grey-dark">
                    <div class="card-content">
                        <p class="title is-5 has-text-light">@book.Title</p>
                        <p class="subtitle is-6 has-text-grey-light">@string.Join(", ", book.AuthorNames)</p>
                        <p class="subtitle is-6 has-text-grey-light">@string.Join(", ", book.GenreNames)</p>
                        <p class="has-text-info">$@book.Price</p>
                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            <form method="post" asp-page-handler="Buy">
                            <input type="hidden" name="bookId" value="@book.Id" />
                            <button type="submit" class="btn btn-primary">Comprar</button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-secondary" asp-page="/Login">Inicia sesión para comprar</a>
                        }
                            </div>
                </div>
            </div>
        }
    }
</div>
