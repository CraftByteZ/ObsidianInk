@page
@model Web.Pages.CatalogModel
@{
    ViewData["Title"] = "Catálogo";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
    <div>
        <span class="badge rounded-pill text-bg-primary mb-2">@Model.Books.Count libros disponibles</span>
        <h1 class="text-primary mb-1">Catálogo de libros</h1>
        <p class="text-muted mb-0">Explora el inventario demo, revisa detalles y compra con una cuenta de prueba.</p>
    </div>
    @if (!(User.Identity?.IsAuthenticated ?? false))
    {
        <a asp-page="/Login" class="btn btn-outline-light">Iniciar sesión para comprar</a>
    }
</div>

@if (TempData["Error"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

@if (Model.Books.Count == 0)
{
    <section class="content-section text-center">
        <h2 class="h4 text-primary">No hay libros disponibles</h2>
        <p class="text-muted mb-0">Cuando el API devuelva libros, aparecerán automáticamente en este catálogo.</p>
    </section>
}
else
{
    <div class="row g-4">
        @foreach (var book in Model.Books)
        {
            <div class="col-sm-6 col-lg-4 col-xl-3">
                <article class="card bg-dark text-light border-0 shadow-sm h-100 book-card-compact">
                    <img src="@book.Cover" class="card-img-top catalog-cover" alt="Portada de @book.Title">
                    <div class="card-body d-flex flex-column">
                        <h2 class="h5 card-title text-primary">@book.Title</h2>
                        <p class="card-text mb-1">@string.Join(", ", book.AuthorNames)</p>
                        <p class="text-muted small mb-3">@string.Join(", ", book.GenreNames)</p>
                        <p class="fw-bold fs-5 mt-auto">@book.Price.ToString("C")</p>

                        <div class="d-grid gap-2">
                            <a asp-page="/BookDetails" asp-route-id="@book.Id" class="btn btn-outline-light">Ver detalles</a>
                            @if (User.Identity?.IsAuthenticated ?? false)
                            {
                                <form method="post" asp-page-handler="Buy">
                                    <input type="hidden" name="bookId" value="@book.Id" />
                                    <button type="submit" class="btn btn-primary w-100">Comprar</button>
                                </form>
                            }
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>
}
