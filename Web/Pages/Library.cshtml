@page
@model Web.Pages.LibraryModel
@{
    ViewData["Title"] = "Mi Biblioteca";
}

<h2 class="text-primary mb-4">Mi Biblioteca</h2>

@if (Model.MyBooks == null || !Model.MyBooks.Any())
{
    <p class="text-muted">No has comprado ningún libro aún.</p>
}
else
{
    <div class="row g-4">
        @foreach (var book in Model.MyBooks)
        {
            <div class="col-md-3">
                <div class="card bg-dark text-light shadow-sm h-100">
                    <img src="@book.Cover" class="card-img-top" alt="@book.Title">
                    <div class="card-body">
                        <h5 class="text-primary">@book.Title</h5>
                        <p>@book.Description</p>
                        <small class="text-muted">Autores: @string.Join(", ", book.AuthorNames)</small>
                        <div class="mt-3">
                            <a href="@book.UrlFile" target="_blank" class="btn btn-success w-100">Leer libro</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
