@page
@model Web.Pages.LibraryModel
@{
    ViewData["Title"] = "Mi Biblioteca";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-2 mb-4">
    <div>
        <span class="badge rounded-pill text-bg-primary mb-2">Biblioteca personal</span>
        <h1 class="display-6 fw-bold text-primary mb-1">Mi Biblioteca</h1>
        <p class="text-muted mb-0">Tus compras listas para leer.</p>
    </div>
</div>

@if (Model.MyBooks == null || !Model.MyBooks.Any())
{
    <section class="content-section text-center">
        <h2 class="h4 text-primary">Tu biblioteca está vacía</h2>
        <p class="text-muted mb-3">No has comprado ningún libro aún.</p>
        <a asp-page="/Catalog" class="btn btn-primary">Explorar catálogo</a>
    </section>
}
else
{
    <div class="row g-4">
        @foreach (var book in Model.MyBooks)
        {
            <div class="col-sm-6 col-lg-4 col-xl-3">
                <article class="card oi-card h-100">
                    <img src="@book.Cover" class="card-img-top library-cover" alt="Portada de @book.Title">
                    <div class="card-body d-flex flex-column p-4">
                        <h2 class="h5 card-title fw-bold mb-2">@book.Title</h2>
                        <p class="book-meta mb-3">@string.Join(", ", book.AuthorNames)</p>
                        <p class="card-text line-clamp-3 mb-4">@book.Description</p>
                        <div class="mt-auto d-grid">
                            <a href="@book.UrlFile" target="_blank" class="btn btn-primary">Leer libro</a>
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>
}
