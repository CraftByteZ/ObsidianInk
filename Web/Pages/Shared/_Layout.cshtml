@{
    var isLogged = User.Identity?.IsAuthenticated ?? false;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Obsidian Ink</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body class="bg-dark text-light">

    <nav class="navbar navbar-expand-lg navbar-dark bg-black shadow-sm border-bottom border-secondary">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold text-light" asp-page="/Index">🖋️ Obsidian Ink</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div id="mainNav" class="collapse navbar-collapse">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item"><a class="nav-link" asp-page="/Catalog">Catálogo</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/About">Acerca</a></li>
                </ul>

                <ul class="navbar-nav ms-auto">
                    @if (isLogged)
                    {
                        <li class="nav-item"><a class="nav-link" asp-page="/Library">Mi Biblioteca</a></li>
                        <li class="nav-item">
                            <form method="post" asp-page="/Logout" class="d-inline">
                                <button class="btn btn-outline-danger btn-sm ms-2">Cerrar sesión</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="btn btn-primary btn-sm" asp-page="/Login">Iniciar sesión</a></li>
                        <li class="nav-item"><a class="btn btn-primary btn-sm" asp-page="/Register">Registrarse</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main class="container my-5">
        @RenderBody()
    </main>

    <footer class="footer border-top border-secondary py-3 text-muted">
        <div class="container">
            © 2025 - Obsidian Ink · <a asp-page="/Privacy" class="text-light text-decoration-none">Privacidad</a>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
