@{
    var isLogged = User.Identity?.IsAuthenticated ?? false;
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Obsidian Ink</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bulma@0.9.4/css/bulma.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>

<body class="has-background-dark has-text-light">
    <nav class="navbar is-dark" role="navigation">
        <div class="navbar-brand">
            <a class="navbar-item" asp-page="/Index">🖋️ Obsidian Ink</a>
        </div>
        <div class="navbar-menu">
            <div class="navbar-start">
                <a class="navbar-item" asp-page="/Catalog">Catálogo</a>
                <a class="navbar-item" asp-page="/About">Acerca</a>
            </div>
            <div class="navbar-end">
                @if (User.Identity.IsAuthenticated)
                {
                    <a class="navbar-item" asp-page="/Library">Mi Biblioteca</a>
                    <form method="post" asp-page="/Logout" class="navbar-item">
                        <button class="button is-small is-danger">Cerrar sesión</button>
                    </form>
                }
                else
                {
                    <a class="navbar-item" asp-page="/Login">Iniciar sesión</a>
                    <a class="navbar-item" asp-page="/Register">Registrarse</a>
                }
            </div>
        </div>
    </nav>
    <section class="section">
        <div class="container">
            @RenderBody()
        </div>
    </section>
</body>

</html>