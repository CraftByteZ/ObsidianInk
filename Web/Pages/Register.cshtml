@page
@model Web.Pages.RegisterModel
@{
    ViewData["Title"] = "Registrarse";
}

<div class="d-flex justify-content-center">
    <div class="card bg-dark text-light shadow p-4" style="max-width: 400px;">
        <h2 class="text-center mb-4 text-primary">Registrarse</h2>

        @if (!string.IsNullOrEmpty(Model.AlertMessage))
        {
            <div class="alert alert-@Model.AlertType" role="alert">
                @Model.AlertMessage
            </div>
        }

        <form method="post">
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="mb-3">
                <label class="form-label">Nombre de usuario</label>
                <input asp-for="User.Username" class="form-control" placeholder="NombreDeUsuario" />
                <span asp-validation-for="User.Username" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Correo electrónico</label>
                <input asp-for="User.Email" class="form-control" placeholder="usuario@email.com" />
                <span asp-validation-for="User.Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Celular</label>
                <input asp-for="User.Phone" class="form-control" placeholder="XXX-XXX-XXXX" />
                <span asp-validation-for="User.Phone" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Contraseña</label>
                <input asp-for="User.Password" type="password" class="form-control" placeholder="••••••••" />
                <span asp-validation-for="User.Password" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">Registrarse</button>
        </form>

        <p class="text-center mt-3">
            ¿Ya tienes cuenta?
            <a asp-page="/Login" class="text-decoration-none text-info">Loguéate aquí</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}