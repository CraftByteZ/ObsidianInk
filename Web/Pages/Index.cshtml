@page
@model Web.Pages.IndexModel
@{
    ViewData["Title"] = "Obsidian Ink";
}

<section class="section">
    <div class="container">
        <div class="box has-background-dark">
            <h1 class="title is-1 has-text-centered has-text-light">🖋️ Obsidian Ink</h1>
            <h2 class="subtitle is-4 has-text-centered has-text-grey-light">Tu librería digital oscura y elegante</h2>
            <div class="has-text-centered mt-5">
                <a class="button is-primary is-large" asp-page="/Catalog">Explorar libros</a>
                <a class="button is-link is-large ml-3" asp-page="/Login">Iniciar sesión</a>
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="columns is-vcentered">
            <div class="column is-half">
                <figure class="image is-4by3">
                    <img src="/images/reading_dark.jpg" alt="Lectura en modo oscuro">
                </figure>
            </div>
            <div class="column is-half">
                <h2 class="title is-2">¿Por qué elegir Obsidian Ink?</h2>
                <ul class="content">
                    <li>📚 Amplia selección de libros en diversos géneros.</li>
                    <li>🌙 Modo oscuro para una experiencia de lectura cómoda.</li>
                    <li>🔒 Seguridad y privacidad de tus datos.</li>
                    <li>💡 Recomendaciones personalizadas basadas en tus gustos.</li>
                    <li>📱 Acceso desde cualquier dispositivo, en cualquier momento.</li
                    </ul
            </div>
        </section> 

