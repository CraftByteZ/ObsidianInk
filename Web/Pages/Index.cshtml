@page
@using Microsoft.AspNetCore.Mvc.RazorPages;
@model Web.Pages.LibraryModel
@{
    ViewData["Title"] = "Mi Biblioteca";
}

<h1 class="title has-text-centered has-text-light">Tu Biblioteca</h1>

@if (Model. MyBooks.Count == 0)
{
    <p class="has-text-grey-light">Aún no tienes libros comprados.</p>
}
else
{
    <div class="columns is-multiline">
        @foreach (var book in Model.MyBooks)
        {
            <div class="column is-one-quarter">
                <div class="card has-background-grey-dark">
                    <div class="card-content">
                        <p class="title is-5 has-text-light">@book.Title</p>
                        <p class="subtitle is-6 has-text-grey-light">@string.Join(", ", book.AuthorNames)</p>
                        <a class="button is-link is-small mt-2" href="@book.UrlFile" target="_blank">Leer</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
