@page
@model Web.Pages.IndexModel
@{
    ViewData["Title"] = "Inicio";
}

<section class="hero-panel rounded-4 overflow-hidden">
    <div class="row align-items-stretch g-0">
        <div class="col-lg-7 p-5 d-flex flex-column justify-content-center">
            <span class="badge rounded-pill text-bg-primary align-self-start mb-3">Demo</span>
            <h1 class="display-3 fw-bold hero-title mb-3">Obsidian Ink</h1>
            <p class="lead text-light-50 hero-copy mb-4">Una librería digital oscura, clara y moderna con catálogo, autenticación por cookie, compras y biblioteca personal.</p>
            <div class="d-flex flex-wrap gap-3 mb-4">
                <a asp-page="/Catalog" class="btn btn-primary btn-lg">Explorar catálogo</a>
                <a asp-page="/Login" class="btn btn-outline-light btn-lg">Probar demo</a>
            </div>
        </div>
        <div class="row g-3">
                <div class="col-sm-4">
                    <div class="hero-stat h-100">
                        <div class="fw-bold text-white">Catálogo</div>
                        <small class="text-light-50">Portadas y precios</small>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="hero-stat h-100">
                        <div class="fw-bold text-white">Compras</div>
                        <small class="text-light-50">Flujo</small>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="hero-stat h-100">
                        <div class="fw-bold text-white">Biblioteca</div>
                        <small class="text-light-50">Lectura personal</small>
                    </div>
                </div>
            </div>
        <div class="col-lg-5 p-5 bg-black bg-opacity-25 d-flex align-items-center">
            <div class="demo-card w-100">
                <span class="badge rounded-pill genre-badge mb-3">Acceso rápido</span>
                <h2 class="h4 text-primary fw-bold">Credenciales</h2>
                <div class="mt-3">
                    <p class="mb-2"><strong>Email:</strong> demo@obsidianink.local</p>
                    <p class="mb-0"><strong>Contraseña:</strong> password123</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="mt-5">
    <div class="row g-4">
        <div class="col-md-4">
            <div class="content-section h-100">
                <h2 class="h4 fw-bold">📚 Catálogo curado</h2>
                <p class="mb-0">Consulta portadas, autores, géneros, precios y detalles de cada libro desde una interfaz clara.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="content-section h-100">
                <h2 class="h4 fw-bold">🛒 Compra demo</h2>
                <p class="mb-0">El flujo de compra crea órdenes de demostración y redirige a la biblioteca personal.</p>
            </div>
        </div>
    </div>
</section>
