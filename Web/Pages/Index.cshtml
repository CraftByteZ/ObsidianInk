@page
@model Web.Pages.IndexModel
@{
    ViewData["Title"] = "Inicio";
}

<section class="text-center py-5 bg-dark text-light rounded shadow-sm">
    <h1 class="display-4 fw-bold">Obsidian Ink</h1>
    <p class="lead text-secondary">Tu librería digital oscura y elegante</p>
    <div class="mt-4">
        <a asp-page="/Catalog" class="btn btn-primary btn-lg me-3">Explorar libros</a>
        <a asp-page="/Login" class="btn btn-primary btn-lg me-3">Iniciar sesión</a>
    </div>
</section>

<section class="mt-5">
    <div class="row align-items-center">
        <div class="col-md-6 mb-4">
            <img src="/images/reading_dark.jpg" class="img-fluid rounded shadow" alt="Lectura en modo oscuro">
        </div>
        <div class="col-md-6">
            <h2 class="text-primary mb-3">¿Por qué elegir Obsidian Ink?</h2>
            <ul class="list-group list-group-flush bg-transparent">
                <li class="list-group-item bg-transparent">📚 Amplia selección de libros</li>
                <li class="list-group-item bg-transparent">🌙 Modo oscuro cómodo</li>
                <li class="list-group-item bg-transparent">🔒 Seguridad y privacidad</li>
                <li class="list-group-item bg-transparent">💡 Recomendaciones personalizadas</li>
                <li class="list-group-item bg-transparent">📱 Accesible en cualquier dispositivo</li>
            </ul>
        </div>
    </div>
</section>
